# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ai_recruiter

# Encryption key (AES-256-GCM) — generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=your-256-bit-hex-key-here

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# RouterAI models
ROUTERAI_LLM_MODEL=openai/gpt-5.6-luna-pro
ROUTERAI_STT_MODEL=x-ai/grok-stt-1.0
ROUTERAI_TTS_MODEL=microsoft/mai-voice-2-flash
ROUTERAI_TTS_VOICE=ru-RU-Masha:MAI-Voice-2-Flash

# Admin (служебная страница с отчётами)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Interview settings
INTERVIEW_MIN_QUESTIONS=5
INTERVIEW_TARGET_QUESTIONS=7
INTERVIEW_MAX_QUESTIONS=10
MAX_AUDIO_SIZE_MB=20